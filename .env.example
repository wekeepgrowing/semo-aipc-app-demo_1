# Local Docker development data mounts
# - OPENCLAW_DATA_PATH maps to /data inside container
# - OPENCLAW_LINUXBREW_PATH maps to /home/linuxbrew inside container
#
# Default (if omitted):
# OPENCLAW_DATA_PATH=./data
# OPENCLAW_LINUXBREW_PATH=./data/linuxbrew
#
# Example absolute host paths:
# OPENCLAW_DATA_PATH=/Users/yourname/.semo/openclaw-data
# OPENCLAW_LINUXBREW_PATH=/Users/yourname/.semo/openclaw-data/linuxbrew

# OPENCLAW_DATA_PATH=
# OPENCLAW_LINUXBREW_PATH=
