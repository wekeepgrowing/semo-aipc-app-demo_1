# Local Docker development data mounts
# - OPENCLAW_DATA_PATH maps to /data inside the Semo AI container
# - OPENCLAW_LINUXBREW_PATH maps to /home/linuxbrew inside the Semo AI container
#
# Default (if omitted):
# OPENCLAW_DATA_PATH=./data
# OPENCLAW_LINUXBREW_PATH=./data/linuxbrew
#
# Example absolute host paths:
# OPENCLAW_DATA_PATH=/Users/yourname/.semo/semo-ai-data
# OPENCLAW_LINUXBREW_PATH=/Users/yourname/.semo/semo-ai-data/linuxbrew

# OPENCLAW_DATA_PATH=
# OPENCLAW_LINUXBREW_PATH=
