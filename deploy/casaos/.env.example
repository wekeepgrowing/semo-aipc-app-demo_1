# CasaOS x86 custom install
# If the GHCR package is private, run `docker login ghcr.io` on the CasaOS host first.
SEMO_AI_IMAGE=ghcr.io/wekeepgrowing/semo-ai-app:semo-ai-2026.3.2-amd64
SEMO_ASSISTANT_NAME=Semo AI
TMPDIR=/data/.tmp
TMP=/data/.tmp
TEMP=/data/.tmp

# Leave blank on CasaOS to use local container metrics fallback.
OUR_OS_METRICS_BASE_URL=
OUR_OS_METRICS_PATH=/api/v1/system/metrics
OUR_OS_METRICS_AUTH_MODE=none
OUR_OS_METRICS_TOKEN=
OUR_OS_METRICS_TOKEN_FILE=
OUR_OS_METRICS_TIMEOUT_MS=3500
